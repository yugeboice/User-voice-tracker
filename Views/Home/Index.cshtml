@{
    Layout = "_Layout";
    ViewData["Title"] = "Home";
}

@section Styles {
    <link href="~/css/logs.css" rel="stylesheet" />
}

@model LuminaSearchConsole.Models.SearchViewModel

<div class="row">
    <div class="col-md-12">

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Message"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Authentication Section -->
        @if (!Model.IsAuthenticated)
        {
            <div class="auth-section">
                <h3>Welcome!</h3>
                <p class="text-muted">Sign in to start searching for company information</p>
                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary">Sign In with Microsoft</button>
                </form>
            </div>
        }
        else
        {
            <!-- Logged in status bar -->
            <div class="alert alert-success d-flex justify-content-between align-items-center mb-4">
                <span>✅ You're signed in</span>
                <form asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-secondary btn-sm">Sign Out</button>
                </form>
            </div>
        }

        <!-- API Logs Section -->
        @if (Model.IsAuthenticated)
        {
            <div class="api-logs-section mt-4">
                <div class="card">
                    <div class="card-header" style="cursor: pointer;" onclick="toggleLogs()">
                        <h5 class="mb-0">
                            <span id="logsToggleIcon">▶️</span>
                            📋 API Call Logs
                            <small class="text-muted">(Click to expand/collapse)</small>
                        </h5>
                    </div>
                    <div class="card-body" id="apiLogsBody" style="display: none;">
                        @if (Model.ApiLogs != null && Model.ApiLogs.Any())
                        {
                            <div class="api-logs">
                                @foreach (var log in Model.ApiLogs)
                                {
                                    var statusClass = log.Success ? "success" : "danger";
                                    var statusIcon = log.Success ? "✅" : "❌";
                                    
                                    <div class="log-entry log-@statusClass">
                                        <div class="log-header">
                                            <span class="log-icon">@statusIcon</span>
                                            <span class="log-time">@log.Timestamp.ToString("HH:mm:ss.fff")</span>
                                            <span class="log-api badge bg-@statusClass">@log.ApiName</span>
                                            <span class="log-operation">@log.Operation</span>
                                        </div>
                                        <div class="log-details">@log.Details</div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">No API calls logged yet. Perform authentication or search to see logs.</p>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Main Search Box (Full Width) -->
        @if (Model.IsAuthenticated)
        {
            <div class="main-search-container">
                <form asp-action="Search" method="post" id="searchForm" onsubmit="handleSearchSubmit(event)">
                    @Html.AntiForgeryToken()
                    <div class="search-box-wrapper">
                        <input type="text" class="form-control form-control-lg search-input" id="query" name="Query" 
                               value="@Model.Query" placeholder="Search for any company..." required>
                        <button type="submit" class="btn btn-primary btn-lg search-button" id="searchButton">
                            <span id="searchButtonText">🔍 Search</span>
                            <span id="searchButtonLoading" style="display: none;">
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                Searching...
                            </span>
                        </button>
                    </div>
                    <div class="form-text text-center mt-2">Get instant access to stock prices and latest news powered by <strong>Lumina Search API</strong></div>
                    <input type="hidden" name="TopResults" value="5">
                </form>
            </div>
            
            <!-- Search Results (Full Width) -->
            @if (Model.HasSearched)
            {
                <div class="mt-4">
                    @if (Model.IsBatchSearch && Model.BatchSearchResult != null)
                    {
                        <!-- Batch Search Results (Company Info) -->
                        <h3>📊 Results for "@Model.BatchSearchResult.CompanyName"</h3>
                        
                        <!-- Two Column Layout: Company Overview + CUA Test -->
                        <div class="row mb-4">
                            <!-- Left Column: Company Overview -->
                            <div class="col-md-6">
                                <div class="card h-100" style="border-left: 4px solid #0d6efd;">
                                    <div class="card-header" style="background-color: #f8f9fa;">
                                        <h5 class="mb-0">🏢 Company Overview</h5>
                                        <small class="text-muted">Information extracted from Wikipedia using <strong>Find API</strong></small>
                                    </div>
                                    <div class="card-body" id="companyOverviewCard">
                                        <!-- Company info will be loaded via AJAX -->
                                        <div class="loading-spinner-container">
                                            <div class="spinner-border text-primary" role="status">
                                                <span class="visually-hidden">Loading...</span>
                                            </div>
                                            <p>Extracting company info using <strong>Find API</strong>...</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Right Column: CUA Test -->
                            <div class="col-md-6">
                                <div class="card h-100" style="border-left: 4px solid #17a2b8;">
                                    <div class="card-header" style="background-color: #f8f9fa;">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <h5 class="mb-1">🤖 Stock Price Screenshot</h5>
                                                <small class="text-muted">Automated browser navigation and screenshot capture using <strong>Computer Use Agent (CUA) API</strong></small>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card-body">
                                        <!-- CUA MSN Money Button -->
                                        <div class="mb-3">
                                            @if (!string.IsNullOrEmpty(Model.Query))
                                            {
                                                <div class="d-grid">
                                                    <button type="button" class="btn btn-success" id="cuaMsnBtn" onclick="cuaMsnMoney('@Model.Query')">
                                                        <span id="cuaMsnText">💰 Search on MSN Money</span>
                                                        <span id="cuaMsnLoading" style="display: none;">
                                                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                                            Processing...
                                                        </span>
                                                    </button>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="d-grid">
                                                    <button type="button" class="btn btn-success" disabled>💰 Search on MSN Money</button>
                                                </div>
                                            }
                                        </div>

                                        <!-- CUA Status Messages -->
                                        <div id="cuaStatus" class="alert alert-info" style="display:none; font-size: 0.9rem; max-height: 300px; overflow-y: auto;">
                                            <strong>Progress:</strong>
                                            <div id="cuaStatusText" style="margin-top: 10px; font-family: 'Courier New', monospace; white-space: pre-line;"></div>
                                        </div>
                                        
                                        <!-- CUA Screenshot Display -->
                                        <div id="cuaScreenshot" style="display:none;">
                                            <h6 class="mb-2">📸 Live Search Preview</h6>
                                            <div class="border rounded p-2" style="background-color: #f8f9fa;">
                                                <img id="cuaImage" src="" alt="AI Search Preview" class="img-fluid w-100" style="max-height: 400px; object-fit: contain;">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row">
                            <!-- Stock Price Results (Left Column) -->
                            <div class="col-md-6">
                                <h4 class="text-primary">📈 Stock & Market Data</h4>
                                <p class="text-muted">Showing @Model.BatchSearchResult.StockResults.Count results from <strong>Search API</strong></p>
                                <p class="text-info"><small>💡 Click any article to extract full content using <strong>Open API</strong></small></p>
                                
                                @if (Model.BatchSearchResult.StockResults.Any())
                                {
                                    @foreach (var result in Model.BatchSearchResult.StockResults)
                                    {
                                        <div class="search-result news-result" data-url="@result.Url">
                                            @if (!string.IsNullOrEmpty(result.Title))
                                            {
                                                <h5 class="news-title" style="cursor: pointer; color: #0066cc;">@result.Title</h5>
                                            }
                                            @if (!string.IsNullOrEmpty(result.Url))
                                            {
                                                <div class="url">
                                                    <a href="@result.Url" target="_blank">@result.Url</a>
                                                </div>
                                            }
                                            @if (!string.IsNullOrEmpty(result.Summary))
                                            {
                                                <div class="summary">
                                                    @(result.Summary.Length > 250 ? 
                                                      result.Summary.Substring(0, 250) + "..." : 
                                                      result.Summary)
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="alert alert-warning">
                                        <p class="mb-2">⚠️ No stock data available</p>
                                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="retrySearch()">
                                            🔄 Retry
                                        </button>
                                    </div>
                                }
                            </div>
                            
                            <!-- Latest News Results (Right Column) -->
                            <div class="col-md-6">
                                <h4 class="text-success">📰 Recent News</h4>
                                <p class="text-muted">Showing @Model.BatchSearchResult.NewsResults.Count results from <strong>Search API</strong></p>
                                <p class="text-info"><small>💡 Click any article to extract full content using <strong>Open API</strong></small></p>
                                
                                @if (Model.BatchSearchResult.NewsResults.Any())
                                {
                                    @foreach (var result in Model.BatchSearchResult.NewsResults)
                                    {
                                        <div class="search-result news-result" data-url="@result.Url">
                                            @if (!string.IsNullOrEmpty(result.Title))
                                            {
                                                <h5 class="news-title" style="cursor: pointer; color: #0066cc;">@result.Title</h5>
                                            }
                                            @if (!string.IsNullOrEmpty(result.Url))
                                            {
                                                <div class="url">
                                                    <a href="@result.Url" target="_blank">@result.Url</a>
                                                </div>
                                            }
                                            @if (!string.IsNullOrEmpty(result.Summary))
                                            {
                                                <div class="summary">
                                                    @(result.Summary.Length > 250 ? 
                                                      result.Summary.Substring(0, 250) + "..." : 
                                                      result.Summary)
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="alert alert-warning">
                                        <p class="mb-2">⚠️ No recent articles found</p>
                                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="retrySearch()">
                                            🔄 Retry
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else if (!Model.IsBatchSearch && Model.SearchResults != null)
                    {
                        <!-- Simple Search Results -->
                        <h3>📊 Search Results</h3>
                        <p class="text-muted">@Model.SearchResults.Count results for "@Model.Query"</p>
                        
                        @if (Model.SearchResults.Any())
                        {
                            @foreach (var result in Model.SearchResults)
                            {
                                <div class="search-result">
                                    @if (!string.IsNullOrEmpty(result.Title))
                                    {
                                        <h5>@result.Title</h5>
                                    }
                                    @if (!string.IsNullOrEmpty(result.Url))
                                    {
                                        <div class="url">
                                            <a href="@result.Url" target="_blank">@result.Url</a>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(result.Summary))
                                    {
                                        <div class="summary">
                                            @(result.Summary.Length > 300 ? 
                                              result.Summary.Substring(0, 300) + "..." : 
                                              result.Summary)
                                        </div>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <p class="mb-0">No results found. Try searching for something else.</p>
                            </div>
                        }
                    }
                </div>
            }
        }
    </div>
</div>

<!-- Content Modal -->
<div class="modal fade" id="contentModal" tabindex="-1" aria-labelledby="contentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <div class="w-100">
                    <h5 class="modal-title" id="contentModalLabel">📄 Article</h5>
                    <div id="breadcrumbNav" style="display: none; margin-top: 5px;">
                        <div id="breadcrumbList"></div>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="contentLoading" class="text-center" style="display: none;">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Loading article...</p>
                </div>
                <div id="contentBody" style="max-height: 50vh; overflow-y: auto; margin-bottom: 1rem;"></div>
                
                <!-- Related Links Section -->
                <div id="contentLinks" style="display: none;">
                    <hr>
                    <h6 class="mb-3">
                        <i class="bi bi-arrow-right-circle"></i>
                        Related Links in this Article
                        <small class="text-muted">(using <strong>Click API</strong>)</small>
                    </h6>
                    <div class="list-group" id="linksList" style="max-height: 250px; overflow-y: auto;">
                        <!-- Links will be populated here -->
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <small class="text-muted me-auto">💡 Click links above to navigate deeper using <strong>Click API</strong></small>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/utils.js"></script>
    <script src="~/js/navigation.js"></script>
    <script src="~/js/search.js"></script>
    <script src="~/js/cua.js"></script>
    
    <script>
        // Auto-focus on search input if authenticated
        @if (Model.IsAuthenticated)
        {
            <text>
            document.addEventListener('DOMContentLoaded', function() {
                document.getElementById('query').focus();
                
                // Add click handlers for news results
                const newsResults = document.querySelectorAll('.news-result .news-title');
                newsResults.forEach(function(title) {
                    title.addEventListener('click', function() {
                        const newsResult = this.closest('.news-result');
                        const url = newsResult.getAttribute('data-url');
                        if (url) {
                            openFullContent(url, this.textContent);
                        }
                    });
                    
                    // Add hover effect
                    title.addEventListener('mouseenter', function() {
                        this.style.textDecoration = 'underline';
                    });
                    title.addEventListener('mouseleave', function() {
                        this.style.textDecoration = 'none';
                    });
                });
                
                // Load company info via AJAX (independent from search)
                @if (Model.HasSearched && !string.IsNullOrEmpty(Model.Query))
                {
                    <text>
                    loadCompanyInfo('@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Query))'.slice(1, -1));
                    </text>
                }
            });
            </text>
        }

    </script>
}
