@{
    Layout = "_Layout";
    ViewData["Title"] = "Home";
}

@model LuminaSearchConsole.Models.SearchViewModel

<div class="row">
    <div class="col-md-12">
        <h1 class="mb-4">🔍 Company Search by Lumina</h1>
        
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Message"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Authentication Section -->
        @if (!Model.IsAuthenticated)
        {
            <div class="auth-section">
                <h3>� Welcome!</h3>
                <p class="text-muted">Sign in to start searching for company information</p>
                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary">Sign In with Microsoft</button>
                </form>
            </div>
        }
        else
        {
            <!-- Logged in status bar -->
            <div class="alert alert-success d-flex justify-content-between align-items-center mb-4">
                <span>✅ You're signed in</span>
                <form asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-secondary btn-sm">Sign Out</button>
                </form>
            </div>
        }

        <!-- API Logs Section -->
        @if (Model.IsAuthenticated)
        {
            <div class="api-logs-section mt-4">
                <div class="card">
                    <div class="card-header" style="cursor: pointer;" onclick="toggleLogs()">
                        <h5 class="mb-0">
                            <span id="logsToggleIcon">▶️</span>
                            📋 API Call Logs
                            <small class="text-muted">(Click to expand/collapse)</small>
                        </h5>
                    </div>
                    <div class="card-body" id="apiLogsBody" style="display: none;">
                        @if (Model.ApiLogs != null && Model.ApiLogs.Any())
                        {
                            <div class="api-logs">
                                @foreach (var log in Model.ApiLogs)
                                {
                                    var statusClass = log.Success ? "success" : "danger";
                                    var statusIcon = log.Success ? "✅" : "❌";
                                    
                                    <div class="log-entry log-@statusClass">
                                        <div class="log-header">
                                            <span class="log-icon">@statusIcon</span>
                                            <span class="log-time">@log.Timestamp.ToString("HH:mm:ss.fff")</span>
                                            <span class="log-api badge bg-@statusClass">@log.ApiName</span>
                                            <span class="log-operation">@log.Operation</span>
                                        </div>
                                        <div class="log-details">@log.Details</div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">No API calls logged yet. Perform authentication or search to see logs.</p>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Main Search Box (Full Width) -->
        @if (Model.IsAuthenticated)
        {
            <div class="main-search-container">
                <form asp-action="Search" method="post">
                    @Html.AntiForgeryToken()
                    <div class="search-box-wrapper">
                        <input type="text" class="form-control form-control-lg search-input" id="query" name="Query" 
                               value="@Model.Query" placeholder="Search for any company..." required>
                        <button type="submit" class="btn btn-primary btn-lg search-button">🔍 Search</button>
                    </div>
                    <div class="form-text text-center mt-2">Get instant access to stock prices and latest news</div>
                    <input type="hidden" name="TopResults" value="5">
                </form>
            </div>
            
            <!-- CUA Test Section (Full Width) -->
            <div class="cua-section-horizontal mt-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-1">🤖 Computer Use Agent (CUA) Usecase</h5>
                        <p class="text-muted mb-0 small">Navigate to MSN Money, search stock price, and take a screenshot.</p>
                    </div>
                    <div>
                        @if (!string.IsNullOrEmpty(Model.Query))
                        {
                            <button type="button" class="btn btn-info" onclick="testCua('@Model.Query')">
                                ▶️ Watch AI Search
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-info" disabled>
                                ▶️ Watch AI Search
                            </button>
                        }
                    </div>
                </div>
                
                <!-- CUA Screenshot Display -->
                <div id="cuaScreenshot" class="mt-3" style="display:none;">
                    <h6 class="mb-2">📸 Live Search Preview</h6>
                    <div class="card">
                        <div class="card-body p-2">
                            <img id="cuaImage" src="" alt="AI Search Preview" class="img-fluid w-100" style="max-height: 500px; object-fit: contain; border: 1px solid #ddd;">
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Search Results (Full Width) -->
            @if (Model.HasSearched)
            {
                <div class="mt-4">
                    @if (Model.IsBatchSearch && Model.BatchSearchResult != null)
                    {
                        <!-- Batch Search Results (Company Info) -->
                        <h3>📊 Results for "@Model.BatchSearchResult.CompanyName"</h3>
                        
                        <div class="row">
                            <!-- Stock Price Results (Left Column) -->
                            <div class="col-md-6">
                                <h4 class="text-primary">📈 Stock & Market Data</h4>
                                <p class="text-muted">@Model.BatchSearchResult.StockResults.Count results found</p>
                                
                                @if (Model.BatchSearchResult.StockResults.Any())
                                {
                                    @foreach (var result in Model.BatchSearchResult.StockResults)
                                    {
                                        <div class="search-result">
                                            @if (!string.IsNullOrEmpty(result.Title))
                                            {
                                                <h5>@result.Title</h5>
                                            }
                                            @if (!string.IsNullOrEmpty(result.Url))
                                            {
                                                <div class="url">
                                                    <a href="@result.Url" target="_blank">@result.Url</a>
                                                </div>
                                            }
                                            @if (!string.IsNullOrEmpty(result.Summary))
                                            {
                                                <div class="summary">
                                                    @(result.Summary.Length > 250 ? 
                                                      result.Summary.Substring(0, 250) + "..." : 
                                                      result.Summary)
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="alert alert-info">
                                        <p class="mb-0">No stock data available.</p>
                                    </div>
                                }
                            </div>
                            
                            <!-- Latest News Results (Right Column) -->
                            <div class="col-md-6">
                                <h4 class="text-success">📰 Recent News</h4>
                                <p class="text-muted">@Model.BatchSearchResult.NewsResults.Count articles found</p>
                                <p class="text-info"><small>💡 Click any article to read the full story</small></p>
                                
                                @if (Model.BatchSearchResult.NewsResults.Any())
                                {
                                    @foreach (var result in Model.BatchSearchResult.NewsResults)
                                    {
                                        <div class="search-result news-result" data-url="@result.Url">
                                            @if (!string.IsNullOrEmpty(result.Title))
                                            {
                                                <h5 class="news-title" style="cursor: pointer; color: #0066cc;">@result.Title</h5>
                                            }
                                            @if (!string.IsNullOrEmpty(result.Url))
                                            {
                                                <div class="url">
                                                    <a href="@result.Url" target="_blank">@result.Url</a>
                                                </div>
                                            }
                                            @if (!string.IsNullOrEmpty(result.Summary))
                                            {
                                                <div class="summary">
                                                    @(result.Summary.Length > 250 ? 
                                                      result.Summary.Substring(0, 250) + "..." : 
                                                      result.Summary)
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="alert alert-info">
                                        <p class="mb-0">No recent articles found.</p>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else if (!Model.IsBatchSearch && Model.SearchResults != null)
                    {
                        <!-- Simple Search Results -->
                        <h3>📊 Search Results</h3>
                        <p class="text-muted">@Model.SearchResults.Count results for "@Model.Query"</p>
                        
                        @if (Model.SearchResults.Any())
                        {
                            @foreach (var result in Model.SearchResults)
                            {
                                <div class="search-result">
                                    @if (!string.IsNullOrEmpty(result.Title))
                                    {
                                        <h5>@result.Title</h5>
                                    }
                                    @if (!string.IsNullOrEmpty(result.Url))
                                    {
                                        <div class="url">
                                            <a href="@result.Url" target="_blank">@result.Url</a>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(result.Summary))
                                    {
                                        <div class="summary">
                                            @(result.Summary.Length > 300 ? 
                                              result.Summary.Substring(0, 300) + "..." : 
                                              result.Summary)
                                        </div>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <p class="mb-0">No results found. Try searching for something else.</p>
                            </div>
                        }
                    }
                </div>
            }
        }
    </div>
</div>

<!-- Content Modal -->
<div class="modal fade" id="contentModal" tabindex="-1" aria-labelledby="contentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="contentModalLabel">📄 Article</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="contentLoading" class="text-center" style="display: none;">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Loading article...</p>
                </div>
                <div id="contentBody" style="max-height: 70vh; overflow-y: auto;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Toggle API logs panel
        function toggleLogs() {
            const logsBody = document.getElementById('apiLogsBody');
            const toggleIcon = document.getElementById('logsToggleIcon');
            
            if (logsBody.style.display === 'none') {
                logsBody.style.display = 'block';
                toggleIcon.textContent = '🔽';
            } else {
                logsBody.style.display = 'none';
                toggleIcon.textContent = '▶️';
            }
        }
        
        // Auto-focus on search input if authenticated
        @if (Model.IsAuthenticated)
        {
            <text>
            document.addEventListener('DOMContentLoaded', function() {
                document.getElementById('query').focus();
                
                // Add click handlers for news results
                const newsResults = document.querySelectorAll('.news-result .news-title');
                newsResults.forEach(function(title) {
                    title.addEventListener('click', function() {
                        const newsResult = this.closest('.news-result');
                        const url = newsResult.getAttribute('data-url');
                        if (url) {
                            openFullContent(url, this.textContent);
                        }
                    });
                    
                    // Add hover effect
                    title.addEventListener('mouseenter', function() {
                        this.style.textDecoration = 'underline';
                    });
                    title.addEventListener('mouseleave', function() {
                        this.style.textDecoration = 'none';
                    });
                });
            });
            
            function openFullContent(url, title) {
                // Show modal and loading
                const modal = new bootstrap.Modal(document.getElementById('contentModal'));
                document.getElementById('contentModalLabel').textContent = '📄 ' + title;
                document.getElementById('contentLoading').style.display = 'block';
                document.getElementById('contentBody').innerHTML = '';
                modal.show();
                
                // Make AJAX request to open content
                fetch('/Home/OpenContent', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ url: url })
                })
                .then(response => response.json())
                .then(data => {
                    document.getElementById('contentLoading').style.display = 'none';
                    
                    if (data.success) {
                        // Format and display content
                        const formattedContent = formatContent(data.content);
                        document.getElementById('contentBody').innerHTML = formattedContent;
                    } else {
                        document.getElementById('contentBody').innerHTML = 
                            '<div class="alert alert-danger">Error: ' + data.error + '</div>';
                    }
                    
                    // Refresh logs to show the Open API call
                    if (data.logsUpdated) {
                        refreshLogs();
                    }
                })
                .catch(error => {
                    document.getElementById('contentLoading').style.display = 'none';
                    document.getElementById('contentBody').innerHTML = 
                        '<div class="alert alert-danger">Error loading content: ' + error.message + '</div>';
                });
            }
            
            function refreshLogs() {
                // Fetch updated logs from server
                fetch('/Home/GetLogs')
                    .then(response => response.json())
                    .then(data => {
                        if (data.success && data.logsHtml) {
                            const logsContainer = document.querySelector('.api-logs');
                            if (logsContainer) {
                                logsContainer.outerHTML = data.logsHtml;
                            }
                        }
                    })
                    .catch(error => console.error('Failed to refresh logs:', error));
            }
            
            function formatContent(content) {
                // Basic formatting for better readability
                let formatted = content
                    .replace(/\n/g, '<br>')
                    .replace(/\t/g, '&nbsp;&nbsp;&nbsp;&nbsp;')
                    .replace(/(https?:\/\/[^\s]+)/g, '<a href="$1" target="_blank">$1</a>');
                
                return '<div class="content-display">' + formatted + '</div>';
            }
            </text>
        }
    </script>

    <style>
        .api-logs-section {
            margin-bottom: 2rem;
        }
        
        .api-logs-section .card-header {
            background-color: #f8f9fa;
            border-bottom: 2px solid #dee2e6;
        }
        
        .api-logs-section .card-header:hover {
            background-color: #e9ecef;
        }
        
        .api-logs {
            max-height: 400px;
            overflow-y: auto;
            border: 1px solid #dee2e6;
            border-radius: 4px;
            padding: 10px;
            background-color: #f8f9fa;
        }
        
        .log-entry {
            margin-bottom: 10px;
            padding: 10px;
            border-radius: 4px;
            border-left: 4px solid #6c757d;
            background-color: white;
        }
        
        .log-entry.log-success {
            border-left-color: #28a745;
        }
        
        .log-entry.log-danger {
            border-left-color: #dc3545;
        }
        
        .log-header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 5px;
            font-weight: 600;
        }
        
        .log-icon {
            font-size: 1.2em;
        }
        
        .log-time {
            font-family: 'Courier New', monospace;
            font-size: 0.85em;
            color: #6c757d;
        }
        
        .log-api {
            font-size: 0.75em;
            padding: 2px 8px;
        }
        
        .log-operation {
            color: #495057;
            font-weight: 500;
        }
        
        .log-details {
            margin-left: 35px;
            color: #6c757d;
            font-size: 0.9em;
            font-family: 'Courier New', monospace;
            white-space: pre-wrap;
            word-break: break-word;
        }
        
        .news-title:hover {
            color: #004499 !important;
        }
        .content-display {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            line-height: 1.6;
            white-space: pre-wrap;
        }
        .content-display a {
            color: #0066cc;
            text-decoration: none;
        }
        .content-display a:hover {
            text-decoration: underline;
        }
    </style>
    
    <script>
        // CUA Test Function
        async function testCua(companyName) {
            const button = event.target;
            button.disabled = true;
            button.textContent = '⏳ Testing CUA...';
            
            document.getElementById('cuaScreenshot').style.display = 'none';
            
            // Clear previous CUA logs
            const cuaLogsDiv = document.getElementById('cuaLogs');
            cuaLogsDiv.innerHTML = '<em>Initializing CUA...</em>';
            
            try {
                const response = await fetch('@Url.Action("TestCua", "Home")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ CompanyName: companyName })
                });
                
                const result = await response.json();
                
                if (result.success) {
                    // Display screenshot
                    document.getElementById('cuaImage').src = result.screenshot;
                    document.getElementById('cuaScreenshot').style.display = 'block';
                    
                    // Fetch and display CUA-specific logs
                    await refreshCuaLogs();
                    
                    // Refresh main logs to show CUA operations
                    refreshLogs();
                } else {
                    cuaLogsDiv.innerHTML = '<span style="color: red;">❌ CUA Test Failed: ' + result.error + '</span>';
                    document.getElementById('cuaScreenshot').style.display = 'block';
                    alert('CUA Test Failed: ' + result.error);
                }
            } catch (error) {
                cuaLogsDiv.innerHTML = '<span style="color: red;">❌ Error: ' + error.message + '</span>';
                document.getElementById('cuaScreenshot').style.display = 'block';
                alert('Error testing CUA: ' + error.message);
            } finally {
                button.disabled = false;
                button.textContent = '🖥️ Test CUA - Search Stock Price on Bing';
            }
        }
        
        async function refreshCuaLogs() {
            try {
                const response = await fetch('/Home/GetLogs');
                const data = await response.json();
                
                if (data.success && data.logs) {
                    // Filter CUA-related logs
                    const cuaLogs = data.logs.filter(log => log.category === 'Lumina CUA');
                    
                    if (cuaLogs.length > 0) {
                        const cuaLogsDiv = document.getElementById('cuaLogs');
                        let logsHtml = '';
                        
                        cuaLogs.forEach(log => {
                            const statusIcon = log.isSuccess ? '✅' : '❌';
                            const statusColor = log.isSuccess ? '#28a745' : '#dc3545';
                            const timestamp = new Date(log.timestamp).toLocaleTimeString();
                            
                            logsHtml += `<div style="margin-bottom: 10px; padding: 8px; border-left: 3px solid ${statusColor}; background-color: #f8f9fa;">`;
                            logsHtml += `<strong style="color: ${statusColor};">${statusIcon} ${log.operation}</strong> `;
                            logsHtml += `<small style="color: #6c757d;">[${timestamp}]</small><br>`;
                            logsHtml += `<span style="white-space: pre-wrap;">${log.details}</span>`;
                            logsHtml += `</div>`;
                        });
                        
                        cuaLogsDiv.innerHTML = logsHtml;
                    }
                }
            } catch (error) {
                console.error('Failed to refresh CUA logs:', error);
            }
        }
    </script>
}