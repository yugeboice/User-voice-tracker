@{
    Layout = "_Layout";
    ViewData["Title"] = "Home";
}

@model LuminaSearchConsole.Models.SearchViewModel

<div class="row">
    <div class="col-md-12">
        <h1 class="mb-4">🚀 Lumina Search Interface</h1>
        
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Message"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Authentication Section -->
        <div class="auth-section">
            <h3>📋 Step 1: Authentication</h3>
            @if (!Model.IsAuthenticated)
            {
                <p class="text-muted">You need to log in to access Lumina search functionality.</p>
                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary">🔑 Login with Microsoft</button>
                </form>
            }
            else
            {
                <p class="text-success">✅ Successfully authenticated! You can now search.</p>
                <form asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-secondary btn-sm">🚪 Logout</button>
                </form>
            }
        </div>

        <!-- Search Section -->
        @if (Model.IsAuthenticated)
        {
            <div class="search-section">
                <h3>🔍 Step 2: Search</h3>
                <form asp-action="Search" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label for="query" class="form-label">Company Name</label>
                        <input type="text" class="form-control" id="query" name="Query" 
                               value="@Model.Query" placeholder="Enter company name (e.g., Microsoft, Apple, Google)..." required>
                        <div class="form-text">This will search for both stock price and latest news about the company.</div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="topResults" class="form-label">Number of Results per Category</label>
                        <select class="form-select" id="topResults" name="TopResults">
                            <option value="3" selected="@(Model.TopResults == 3)">3 results</option>
                            <option value="5" selected="@(Model.TopResults == 5)">5 results</option>
                            <option value="10" selected="@(Model.TopResults == 10)">10 results</option>
                        </select>
                    </div>
                    
                    <button type="submit" class="btn btn-success">🚀 Search Company Info</button>
                </form>
                
                <div class="mt-3">
                    <form asp-action="SimpleSearch" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Query" value="@Model.Query">
                        <input type="hidden" name="TopResults" value="@Model.TopResults">
                        <button type="submit" class="btn btn-outline-primary btn-sm">🔍 Simple Search</button>
                    </form>
                </div>
            </div>

            <!-- Search Results -->
            @if (Model.HasSearched)
            {
                <div class="mt-4">
                    @if (Model.IsBatchSearch && Model.BatchSearchResult != null)
                    {
                        <!-- Batch Search Results (Company Info) -->
                        <h3>📊 Company Search Results for "@Model.BatchSearchResult.CompanyName"</h3>
                        
                        <div class="row">
                            <!-- Stock Price Results (Left Column) -->
                            <div class="col-md-6">
                                <h4 class="text-primary">📈 Stock Price Information</h4>
                                <p class="text-muted">Found @Model.BatchSearchResult.StockResults.Count stock-related results:</p>
                                
                                @if (Model.BatchSearchResult.StockResults.Any())
                                {
                                    @foreach (var result in Model.BatchSearchResult.StockResults)
                                    {
                                        <div class="search-result">
                                            @if (!string.IsNullOrEmpty(result.Title))
                                            {
                                                <h5>@result.Title</h5>
                                            }
                                            @if (!string.IsNullOrEmpty(result.Url))
                                            {
                                                <div class="url">
                                                    <a href="@result.Url" target="_blank">@result.Url</a>
                                                </div>
                                            }
                                            @if (!string.IsNullOrEmpty(result.Summary))
                                            {
                                                <div class="summary">
                                                    @(result.Summary.Length > 250 ? 
                                                      result.Summary.Substring(0, 250) + "..." : 
                                                      result.Summary)
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="alert alert-info">
                                        <p class="mb-0">No stock price information found.</p>
                                    </div>
                                }
                            </div>
                            
                            <!-- Latest News Results (Right Column) -->
                            <div class="col-md-6">
                                <h4 class="text-success">📰 Latest News</h4>
                                <p class="text-muted">Found @Model.BatchSearchResult.NewsResults.Count news results:</p>
                                <p class="text-info"><small>💡 Click on any news title to view full content</small></p>
                                
                                @if (Model.BatchSearchResult.NewsResults.Any())
                                {
                                    @foreach (var result in Model.BatchSearchResult.NewsResults)
                                    {
                                        <div class="search-result news-result" data-url="@result.Url">
                                            @if (!string.IsNullOrEmpty(result.Title))
                                            {
                                                <h5 class="news-title" style="cursor: pointer; color: #0066cc;">@result.Title</h5>
                                            }
                                            @if (!string.IsNullOrEmpty(result.Url))
                                            {
                                                <div class="url">
                                                    <a href="@result.Url" target="_blank">@result.Url</a>
                                                </div>
                                            }
                                            @if (!string.IsNullOrEmpty(result.Summary))
                                            {
                                                <div class="summary">
                                                    @(result.Summary.Length > 250 ? 
                                                      result.Summary.Substring(0, 250) + "..." : 
                                                      result.Summary)
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="alert alert-info">
                                        <p class="mb-0">No latest news found.</p>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else if (!Model.IsBatchSearch && Model.SearchResults != null)
                    {
                        <!-- Simple Search Results -->
                        <h3>📊 Search Results</h3>
                        <p class="text-muted">Found @Model.SearchResults.Count results for "@Model.Query"</p>
                        
                        @if (Model.SearchResults.Any())
                        {
                            @foreach (var result in Model.SearchResults)
                            {
                                <div class="search-result">
                                    @if (!string.IsNullOrEmpty(result.Title))
                                    {
                                        <h5>@result.Title</h5>
                                    }
                                    @if (!string.IsNullOrEmpty(result.Url))
                                    {
                                        <div class="url">
                                            <a href="@result.Url" target="_blank">@result.Url</a>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(result.Summary))
                                    {
                                        <div class="summary">
                                            @(result.Summary.Length > 300 ? 
                                              result.Summary.Substring(0, 300) + "..." : 
                                              result.Summary)
                                        </div>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <p class="mb-0">No search results found. Try a different query.</p>
                            </div>
                        }
                    }
                </div>
            }
        }
    </div>
</div>

<!-- Content Modal -->
<div class="modal fade" id="contentModal" tabindex="-1" aria-labelledby="contentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="contentModalLabel">📄 Full Content</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="contentLoading" class="text-center" style="display: none;">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Loading full content...</p>
                </div>
                <div id="contentBody" style="max-height: 70vh; overflow-y: auto;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-focus on search input if authenticated
        @if (Model.IsAuthenticated)
        {
            <text>
            document.addEventListener('DOMContentLoaded', function() {
                document.getElementById('query').focus();
                
                // Add click handlers for news results
                const newsResults = document.querySelectorAll('.news-result .news-title');
                newsResults.forEach(function(title) {
                    title.addEventListener('click', function() {
                        const newsResult = this.closest('.news-result');
                        const url = newsResult.getAttribute('data-url');
                        if (url) {
                            openFullContent(url, this.textContent);
                        }
                    });
                    
                    // Add hover effect
                    title.addEventListener('mouseenter', function() {
                        this.style.textDecoration = 'underline';
                    });
                    title.addEventListener('mouseleave', function() {
                        this.style.textDecoration = 'none';
                    });
                });
            });
            
            function openFullContent(url, title) {
                // Show modal and loading
                const modal = new bootstrap.Modal(document.getElementById('contentModal'));
                document.getElementById('contentModalLabel').textContent = '📄 ' + title;
                document.getElementById('contentLoading').style.display = 'block';
                document.getElementById('contentBody').innerHTML = '';
                modal.show();
                
                // Make AJAX request to open content
                fetch('/Home/OpenContent', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ url: url })
                })
                .then(response => response.json())
                .then(data => {
                    document.getElementById('contentLoading').style.display = 'none';
                    
                    if (data.success) {
                        // Format and display content
                        const formattedContent = formatContent(data.content);
                        document.getElementById('contentBody').innerHTML = formattedContent;
                    } else {
                        document.getElementById('contentBody').innerHTML = 
                            '<div class="alert alert-danger">Error: ' + data.error + '</div>';
                    }
                })
                .catch(error => {
                    document.getElementById('contentLoading').style.display = 'none';
                    document.getElementById('contentBody').innerHTML = 
                        '<div class="alert alert-danger">Error loading content: ' + error.message + '</div>';
                });
            }
            
            function formatContent(content) {
                // Basic formatting for better readability
                let formatted = content
                    .replace(/\n/g, '<br>')
                    .replace(/\t/g, '&nbsp;&nbsp;&nbsp;&nbsp;')
                    .replace(/(https?:\/\/[^\s]+)/g, '<a href="$1" target="_blank">$1</a>');
                
                return '<div class="content-display">' + formatted + '</div>';
            }
            </text>
        }
    </script>

    <style>
        .news-title:hover {
            color: #004499 !important;
        }
        .content-display {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            line-height: 1.6;
            white-space: pre-wrap;
        }
        .content-display a {
            color: #0066cc;
            text-decoration: none;
        }
        .content-display a:hover {
            text-decoration: underline;
        }
    </style>
}