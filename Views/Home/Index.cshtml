@{
    Layout = "_Layout";
    ViewData["Title"] = "Home";
}

@model LuminaSearchConsole.Models.SearchViewModel

<div class="row">
    <div class="col-md-12">

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Message"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Authentication Section -->
        @if (!Model.IsAuthenticated)
        {
            <div class="auth-section">
                <h3>Welcome!</h3>
                <p class="text-muted">Sign in to start searching for company information</p>
                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary">Sign In with Microsoft</button>
                </form>
            </div>
        }
        else
        {
            <!-- Logged in status bar -->
            <div class="alert alert-success d-flex justify-content-between align-items-center mb-4">
                <span>✅ You're signed in</span>
                <form asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-secondary btn-sm">Sign Out</button>
                </form>
            </div>
        }

        <!-- API Logs Section -->
        @if (Model.IsAuthenticated)
        {
            <div class="api-logs-section mt-4">
                <div class="card">
                    <div class="card-header" style="cursor: pointer;" onclick="toggleLogs()">
                        <h5 class="mb-0">
                            <span id="logsToggleIcon">▶️</span>
                            📋 API Call Logs
                            <small class="text-muted">(Click to expand/collapse)</small>
                        </h5>
                    </div>
                    <div class="card-body" id="apiLogsBody" style="display: none;">
                        @if (Model.ApiLogs != null && Model.ApiLogs.Any())
                        {
                            <div class="api-logs">
                                @foreach (var log in Model.ApiLogs)
                                {
                                    var statusClass = log.Success ? "success" : "danger";
                                    var statusIcon = log.Success ? "✅" : "❌";
                                    
                                    <div class="log-entry log-@statusClass">
                                        <div class="log-header">
                                            <span class="log-icon">@statusIcon</span>
                                            <span class="log-time">@log.Timestamp.ToString("HH:mm:ss.fff")</span>
                                            <span class="log-api badge bg-@statusClass">@log.ApiName</span>
                                            <span class="log-operation">@log.Operation</span>
                                        </div>
                                        <div class="log-details">@log.Details</div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">No API calls logged yet. Perform authentication or search to see logs.</p>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Main Search Box (Full Width) -->
        @if (Model.IsAuthenticated)
        {
            <div class="main-search-container">
                <form asp-action="Search" method="post" id="searchForm" onsubmit="handleSearchSubmit(event)">
                    @Html.AntiForgeryToken()
                    <div class="search-box-wrapper">
                        <input type="text" class="form-control form-control-lg search-input" id="query" name="Query" 
                               value="@Model.Query" placeholder="Search for any company..." required>
                        <button type="submit" class="btn btn-primary btn-lg search-button" id="searchButton">
                            <span id="searchButtonText">🔍 Search</span>
                            <span id="searchButtonLoading" style="display: none;">
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                Searching...
                            </span>
                        </button>
                    </div>
                    <div class="form-text text-center mt-2">Get instant access to stock prices and latest news</div>
                    <input type="hidden" name="TopResults" value="5">
                </form>
            </div>
            
            <!-- Search Results (Full Width) -->
            @if (Model.HasSearched)
            {
                <div class="mt-4">
                    @if (Model.IsBatchSearch && Model.BatchSearchResult != null)
                    {
                        <!-- Batch Search Results (Company Info) -->
                        <h3>📊 Results for "@Model.BatchSearchResult.CompanyName"</h3>
                        
                        <!-- Two Column Layout: Company Overview + CUA Test -->
                        <div class="row mb-4">
                            <!-- Left Column: Company Overview -->
                            <div class="col-md-6">
                                <div class="card h-100" style="border-left: 4px solid #0d6efd;">
                                    <div class="card-header" style="background-color: #f8f9fa;">
                                        <h5 class="mb-0">🏢 Company Overview</h5>
                                        <small class="text-muted">Information extracted from Wikipedia using Find API</small>
                                    </div>
                                    <div class="card-body">
                                        @if (Model.CompanyInfo != null && Model.CompanyInfo.Fields.Any())
                                        {
                                            <table class="table table-sm table-borderless mb-0">
                                                @foreach (var field in Model.CompanyInfo.Fields)
                                                {
                                                    <tr>
                                                        <td class="text-end" style="width: 150px; font-weight: 600; color: #495057;">@field.FieldName</td>
                                                        <td style="color: #212529;">@field.Content</td>
                                                    </tr>
                                                }
                                            </table>
                                            <hr class="mt-3 mb-2">
                                            <small class="text-muted">
                                                <a href="@Model.CompanyInfo.Url" target="_blank">View full article on Wikipedia →</a>
                                            </small>
                                        }
                                        else
                                        {
                                            <div class="alert alert-warning mb-0">
                                                <p class="mb-2">⚠️ No company information available</p>
                                                <button type="button" class="btn btn-sm btn-outline-primary" onclick="window.location.reload()">
                                                    🔄 Retry
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Right Column: CUA Test -->
                            <div class="col-md-6">
                                <div class="card h-100" style="border-left: 4px solid #17a2b8;">
                                    <div class="card-header" style="background-color: #f8f9fa;">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <h5 class="mb-1">🤖 Stock Price Screenshot</h5>
                                                <small class="text-muted">Use CUA to navigate to Bing search result page of stock price, and take a screenshot.</small>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card-body">
                                        <!-- CUA MSN Money Button -->
                                        <div class="mb-3">
                                            @if (!string.IsNullOrEmpty(Model.Query))
                                            {
                                                <div class="d-grid">
                                                    <button type="button" class="btn btn-success" id="cuaMsnBtn" onclick="cuaMsnMoney('@Model.Query')">
                                                        <span id="cuaMsnText">💰 Search on MSN Money</span>
                                                        <span id="cuaMsnLoading" style="display: none;">
                                                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                                            Processing...
                                                        </span>
                                                    </button>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="d-grid">
                                                    <button type="button" class="btn btn-success" disabled>💰 Search on MSN Money</button>
                                                </div>
                                            }
                                        </div>

                                        <!-- CUA Status Messages -->
                                        <div id="cuaStatus" class="alert alert-info" style="display:none; font-size: 0.9rem; max-height: 300px; overflow-y: auto;">
                                            <strong>Progress:</strong>
                                            <div id="cuaStatusText" style="margin-top: 10px; font-family: 'Courier New', monospace; white-space: pre-line;"></div>
                                        </div>
                                        
                                        <!-- CUA Screenshot Display -->
                                        <div id="cuaScreenshot" style="display:none;">
                                            <h6 class="mb-2">📸 Live Search Preview</h6>
                                            <div class="border rounded p-2" style="background-color: #f8f9fa;">
                                                <img id="cuaImage" src="" alt="AI Search Preview" class="img-fluid w-100" style="max-height: 400px; object-fit: contain;">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row">
                            <!-- Stock Price Results (Left Column) -->
                            <div class="col-md-6">
                                <h4 class="text-primary">📈 Stock & Market Data</h4>
                                <p class="text-muted">Showing @Model.BatchSearchResult.StockResults.Count results</p>
                                <p class="text-info"><small>💡 Click any article to read the full story (using Open API)</small></p>
                                
                                @if (Model.BatchSearchResult.StockResults.Any())
                                {
                                    @foreach (var result in Model.BatchSearchResult.StockResults)
                                    {
                                        <div class="search-result news-result" data-url="@result.Url">
                                            @if (!string.IsNullOrEmpty(result.Title))
                                            {
                                                <h5 class="news-title" style="cursor: pointer; color: #0066cc;">@result.Title</h5>
                                            }
                                            @if (!string.IsNullOrEmpty(result.Url))
                                            {
                                                <div class="url">
                                                    <a href="@result.Url" target="_blank">@result.Url</a>
                                                </div>
                                            }
                                            @if (!string.IsNullOrEmpty(result.Summary))
                                            {
                                                <div class="summary">
                                                    @(result.Summary.Length > 250 ? 
                                                      result.Summary.Substring(0, 250) + "..." : 
                                                      result.Summary)
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="alert alert-warning">
                                        <p class="mb-2">⚠️ No stock data available</p>
                                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="window.location.reload()">
                                            🔄 Retry
                                        </button>
                                    </div>
                                }
                            </div>
                            
                            <!-- Latest News Results (Right Column) -->
                            <div class="col-md-6">
                                <h4 class="text-success">📰 Recent News</h4>
                                <p class="text-muted">Showing @Model.BatchSearchResult.NewsResults.Count results</p>
                                <p class="text-info"><small>💡 Click any article to read the full story (using Open API)</small></p>
                                
                                @if (Model.BatchSearchResult.NewsResults.Any())
                                {
                                    @foreach (var result in Model.BatchSearchResult.NewsResults)
                                    {
                                        <div class="search-result news-result" data-url="@result.Url">
                                            @if (!string.IsNullOrEmpty(result.Title))
                                            {
                                                <h5 class="news-title" style="cursor: pointer; color: #0066cc;">@result.Title</h5>
                                            }
                                            @if (!string.IsNullOrEmpty(result.Url))
                                            {
                                                <div class="url">
                                                    <a href="@result.Url" target="_blank">@result.Url</a>
                                                </div>
                                            }
                                            @if (!string.IsNullOrEmpty(result.Summary))
                                            {
                                                <div class="summary">
                                                    @(result.Summary.Length > 250 ? 
                                                      result.Summary.Substring(0, 250) + "..." : 
                                                      result.Summary)
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="alert alert-warning">
                                        <p class="mb-2">⚠️ No recent articles found</p>
                                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="window.location.reload()">
                                            🔄 Retry
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else if (!Model.IsBatchSearch && Model.SearchResults != null)
                    {
                        <!-- Simple Search Results -->
                        <h3>📊 Search Results</h3>
                        <p class="text-muted">@Model.SearchResults.Count results for "@Model.Query"</p>
                        
                        @if (Model.SearchResults.Any())
                        {
                            @foreach (var result in Model.SearchResults)
                            {
                                <div class="search-result">
                                    @if (!string.IsNullOrEmpty(result.Title))
                                    {
                                        <h5>@result.Title</h5>
                                    }
                                    @if (!string.IsNullOrEmpty(result.Url))
                                    {
                                        <div class="url">
                                            <a href="@result.Url" target="_blank">@result.Url</a>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(result.Summary))
                                    {
                                        <div class="summary">
                                            @(result.Summary.Length > 300 ? 
                                              result.Summary.Substring(0, 300) + "..." : 
                                              result.Summary)
                                        </div>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <p class="mb-0">No results found. Try searching for something else.</p>
                            </div>
                        }
                    }
                </div>
            }
        }
    </div>
</div>

<!-- Content Modal -->
<div class="modal fade" id="contentModal" tabindex="-1" aria-labelledby="contentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="contentModalLabel">📄 Article</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="contentLoading" class="text-center" style="display: none;">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Loading article...</p>
                </div>
                <div id="contentBody" style="max-height: 70vh; overflow-y: auto;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Toggle API logs panel
        function toggleLogs() {
            const logsBody = document.getElementById('apiLogsBody');
            const toggleIcon = document.getElementById('logsToggleIcon');
            
            if (logsBody.style.display === 'none') {
                logsBody.style.display = 'block';
                toggleIcon.textContent = '🔽';
            } else {
                logsBody.style.display = 'none';
                toggleIcon.textContent = '▶️';
            }
        }
        
        // Auto-focus on search input if authenticated
        @if (Model.IsAuthenticated)
        {
            <text>
            document.addEventListener('DOMContentLoaded', function() {
                document.getElementById('query').focus();
                
                // Add click handlers for news results
                const newsResults = document.querySelectorAll('.news-result .news-title');
                newsResults.forEach(function(title) {
                    title.addEventListener('click', function() {
                        const newsResult = this.closest('.news-result');
                        const url = newsResult.getAttribute('data-url');
                        if (url) {
                            openFullContent(url, this.textContent);
                        }
                    });
                    
                    // Add hover effect
                    title.addEventListener('mouseenter', function() {
                        this.style.textDecoration = 'underline';
                    });
                    title.addEventListener('mouseleave', function() {
                        this.style.textDecoration = 'none';
                    });
                });
            });
            
            function openFullContent(url, title) {
                // Show modal and loading
                const modal = new bootstrap.Modal(document.getElementById('contentModal'));
                document.getElementById('contentModalLabel').textContent = '📄 ' + title;
                document.getElementById('contentLoading').style.display = 'block';
                document.getElementById('contentBody').innerHTML = '';
                modal.show();
                
                // Make AJAX request to open content
                fetch('/Home/OpenContent', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ url: url })
                })
                .then(response => response.json())
                .then(data => {
                    document.getElementById('contentLoading').style.display = 'none';
                    
                    if (data.success) {
                        // Format and display content
                        const formattedContent = formatContent(data.content);
                        document.getElementById('contentBody').innerHTML = formattedContent;
                    } else {
                        document.getElementById('contentBody').innerHTML = 
                            '<div class="alert alert-danger">Error: ' + data.error + '</div>';
                    }
                    
                    // Refresh logs to show the Open API call
                    if (data.logsUpdated) {
                        refreshLogs();
                    }
                })
                .catch(error => {
                    document.getElementById('contentLoading').style.display = 'none';
                    document.getElementById('contentBody').innerHTML = 
                        '<div class="alert alert-danger">Error loading content: ' + error.message + '</div>';
                });
            }
            
            function refreshLogs() {
                // Fetch updated logs from server
                fetch('/Home/GetLogs')
                    .then(response => response.json())
                    .then(data => {
                        if (data.success && data.logsHtml) {
                            const logsContainer = document.querySelector('.api-logs');
                            if (logsContainer) {
                                logsContainer.outerHTML = data.logsHtml;
                            }
                        }
                    })
                    .catch(error => console.error('Failed to refresh logs:', error));
            }
            
            function formatContent(content) {
                // Basic formatting for better readability
                let formatted = content
                    .replace(/\n/g, '<br>')
                    .replace(/\t/g, '&nbsp;&nbsp;&nbsp;&nbsp;')
                    .replace(/(https?:\/\/[^\s]+)/g, '<a href="$1" target="_blank">$1</a>');
                
                return '<div class="content-display">' + formatted + '</div>';
            }
            </text>
        }
    </script>

    <style>
        .api-logs-section {
            margin-bottom: 2rem;
        }
        
        .api-logs-section .card-header {
            background-color: #f8f9fa;
            border-bottom: 2px solid #dee2e6;
        }
        
        .api-logs-section .card-header:hover {
            background-color: #e9ecef;
        }
        
        .api-logs {
            max-height: 400px;
            overflow-y: auto;
            border: 1px solid #dee2e6;
            border-radius: 4px;
            padding: 10px;
            background-color: #f8f9fa;
        }
        
        .log-entry {
            margin-bottom: 10px;
            padding: 10px;
            border-radius: 4px;
            border-left: 4px solid #6c757d;
            background-color: white;
        }
        
        .log-entry.log-success {
            border-left-color: #28a745;
        }
        
        .log-entry.log-danger {
            border-left-color: #dc3545;
        }
        
        .log-header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 5px;
            font-weight: 600;
        }
        
        .log-icon {
            font-size: 1.2em;
        }
        
        .log-time {
            font-family: 'Courier New', monospace;
            font-size: 0.85em;
            color: #6c757d;
        }
        
        .log-api {
            font-size: 0.75em;
            padding: 2px 8px;
        }
        
        .log-operation {
            color: #495057;
            font-weight: 500;
        }
        
        .log-details {
            margin-left: 35px;
            color: #6c757d;
            font-size: 0.9em;
            font-family: 'Courier New', monospace;
            white-space: pre-wrap;
            word-break: break-word;
        }
        
        .news-title:hover {
            color: #004499 !important;
        }
        .content-display {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            line-height: 1.6;
            white-space: pre-wrap;
        }
        .content-display a {
            color: #0066cc;
            text-decoration: none;
        }
        .content-display a:hover {
            text-decoration: underline;
        }
    </style>
    
    <script>
        // Handle search form submit with loading state
        function handleSearchSubmit(event) {
            const searchButton = document.getElementById('searchButton');
            const searchButtonText = document.getElementById('searchButtonText');
            const searchButtonLoading = document.getElementById('searchButtonLoading');
            const queryInput = document.getElementById('query');
            
            // Check if input is empty
            if (!queryInput.value.trim()) {
                return true; // Let browser's native validation handle it
            }
            
            // Show loading state
            searchButton.disabled = true;
            searchButtonText.style.display = 'none';
            searchButtonLoading.style.display = 'inline-block';
            queryInput.readOnly = true; // Use readOnly instead of disabled to preserve form data
            
            // Show loading placeholders
            showLoadingState();
            
            // Form will submit normally, page will reload with results
            return true;
        }

        // Show loading skeleton for search results
        function showLoadingState() {
            // Create loading placeholder HTML
            const loadingHTML = `
                <div id="loadingPlaceholder" class="mt-4">
                    <h3>📊 Searching...</h3>
                    
                    <!-- Two Column Layout: Company Overview + CUA Loading -->
                    <div class="row mb-4">
                        <!-- Left Column: Company Overview Loading -->
                        <div class="col-md-6">
                            <div class="card h-100" style="border-left: 4px solid #0d6efd;">
                                <div class="card-header" style="background-color: #f8f9fa;">
                                    <h5 class="mb-0">🏢 Company Overview</h5>
                                    <small class="text-muted">Loading company information...</small>
                                </div>
                                <div class="card-body">
                                    <div class="loading-spinner-container">
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="visually-hidden">Loading...</span>
                                        </div>
                                        <p>Extracting company info using Find API...</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Right Column: CUA Test Loading -->
                        <div class="col-md-6">
                            <div class="card h-100" style="border-left: 4px solid #17a2b8;">
                                <div class="card-header" style="background-color: #f8f9fa;">
                                    <h5 class="mb-1">🤖 Stock Price Screenshot</h5>
                                    <small class="text-muted">Ready for screenshot</small>
                                </div>
                                <div class="card-body">
                                    <div class="text-center">
                                        <button type="button" class="btn btn-info" disabled>
                                            ▶️ Get Screenshot
                                        </button>
                                        <p class="text-muted mt-3">Will be available after search completes</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <!-- Stock Results Loading -->
                        <div class="col-md-6">
                            <h4 class="text-primary">📈 Stock & Market Data</h4>
                            <p class="text-muted">Loading results...</p>
                            
                            <div class="loading-card">
                                <div class="skeleton skeleton-title"></div>
                                <div class="skeleton skeleton-text" style="width: 60%;"></div>
                                <div class="skeleton skeleton-line"></div>
                                <div class="skeleton skeleton-line"></div>
                                <div class="skeleton skeleton-line"></div>
                            </div>
                            <div class="loading-card">
                                <div class="skeleton skeleton-title"></div>
                                <div class="skeleton skeleton-text" style="width: 60%;"></div>
                                <div class="skeleton skeleton-line"></div>
                                <div class="skeleton skeleton-line"></div>
                                <div class="skeleton skeleton-line"></div>
                            </div>
                        </div>
                        
                        <!-- News Results Loading -->
                        <div class="col-md-6">
                            <h4 class="text-success">📰 Recent News</h4>
                            <p class="text-muted">Loading articles...</p>
                            
                            <div class="loading-card">
                                <div class="skeleton skeleton-title"></div>
                                <div class="skeleton skeleton-text" style="width: 60%;"></div>
                                <div class="skeleton skeleton-line"></div>
                                <div class="skeleton skeleton-line"></div>
                                <div class="skeleton skeleton-line"></div>
                            </div>
                            <div class="loading-card">
                                <div class="skeleton skeleton-title"></div>
                                <div class="skeleton skeleton-text" style="width: 60%;"></div>
                                <div class="skeleton skeleton-line"></div>
                                <div class="skeleton skeleton-line"></div>
                                <div class="skeleton skeleton-line"></div>
                            </div>
                        </div>
                    </div>
                </div>
            `;
            
            // Insert loading placeholder after search form
            const searchContainer = document.querySelector('.main-search-container');
            searchContainer.insertAdjacentHTML('afterend', loadingHTML);
        }
        
        // MSN Money Search - All-in-One with Real-time SSE Streaming
        function cuaMsnMoney(companyName) {
            const btn = document.getElementById('cuaMsnBtn');
            const btnText = document.getElementById('cuaMsnText');
            const btnLoading = document.getElementById('cuaMsnLoading');
            const statusDiv = document.getElementById('cuaStatus');
            const statusText = document.getElementById('cuaStatusText');
            
            btn.disabled = true;
            btnText.style.display = 'none';
            btnLoading.style.display = 'inline-block';
            
            // Show status area
            statusDiv.style.display = 'block';
            statusDiv.className = 'alert alert-info';
            document.getElementById('cuaScreenshot').style.display = 'none';
            
            // Helper function to update status (replaces content, not append)
            function updateStatus(message) {
                statusText.textContent = message;
            }
            
            try {
                console.log('MSN Money: Connecting to SSE stream for:', companyName);
                
                // Create EventSource for Server-Sent Events
                const eventSource = new EventSource('/Home/TestCuaMsnMoneyStream?companyName=' + encodeURIComponent(companyName));
                
                // Handle progress updates
                eventSource.addEventListener('progress', function(e) {
                    console.log('Progress:', e.data);
                    updateStatus(e.data);
                });
                
                // Handle screenshot data
                eventSource.addEventListener('screenshot', function(e) {
                    console.log('Screenshot received');
                    try {
                        const screenshotData = JSON.parse(e.data);
                        document.getElementById('cuaImage').src = screenshotData.image;
                        document.getElementById('cuaScreenshot').style.display = 'block';
                    } catch (error) {
                        console.error('Failed to parse screenshot data:', error);
                    }
                });
                
                // Handle completion
                eventSource.addEventListener('complete', function(e) {
                    console.log('Complete:', e.data);
                    updateStatus(e.data);
                    
                    // Hide progress after a short delay
                    setTimeout(() => {
                        statusDiv.style.display = 'none';
                    }, 1000);
                    
                    // Close the connection
                    eventSource.close();
                    
                    // Re-enable button
                    btn.disabled = false;
                    btnText.style.display = 'inline';
                    btnLoading.style.display = 'none';
                    
                    // Refresh main logs
                    refreshLogs();
                });
                
                // Handle errors
                eventSource.addEventListener('error', function(e) {
                    console.error('SSE Error:', e);
                    
                    statusDiv.className = 'alert alert-danger';
                    if (e.data) {
                        statusText.innerHTML = '❌ Error: ' + e.data + '<br><button type="button" class="btn btn-sm btn-outline-primary mt-2" onclick="cuaMsnMoney(\'' + companyName + '\')">🔄 Retry</button>';
                    } else {
                        statusText.innerHTML = '❌ Connection error. Please try again.<br><button type="button" class="btn btn-sm btn-outline-primary mt-2" onclick="cuaMsnMoney(\'' + companyName + '\')">🔄 Retry</button>';
                    }
                    
                    eventSource.close();
                    
                    // Re-enable button
                    btn.disabled = false;
                    btnText.style.display = 'inline';
                    btnLoading.style.display = 'none';
                });
                
                // Handle connection errors
                eventSource.onerror = function(error) {
                    console.error('EventSource failed:', error);
                    
                    if (eventSource.readyState === EventSource.CLOSED) {
                        console.log('EventSource connection closed');
                    } else {
                        statusDiv.className = 'alert alert-danger';
                        statusText.innerHTML = '❌ Connection failed. Please try again.<br><button type="button" class="btn btn-sm btn-outline-primary mt-2" onclick="cuaMsnMoney(\'' + companyName + '\')">🔄 Retry</button>';
                        
                        eventSource.close();
                        
                        // Re-enable button
                        btn.disabled = false;
                        btnText.style.display = 'inline';
                        btnLoading.style.display = 'none';
                    }
                };
                
            } catch (error) {
                console.error('MSN Money error:', error);
                statusDiv.className = 'alert alert-danger';
                statusText.innerHTML = '❌ Error: ' + error.message + '<br><button type="button" class="btn btn-sm btn-outline-primary mt-2" onclick="cuaMsnMoney(\'' + companyName + '\')">🔄 Retry</button>';
                
                // Re-enable button
                btn.disabled = false;
                btnText.style.display = 'inline';
                btnLoading.style.display = 'none';
            }
        }
        

    </script>
}
