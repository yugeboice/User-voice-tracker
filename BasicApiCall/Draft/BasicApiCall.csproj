<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.13.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.1" />
    <PackageReference Include="Microsoft.Lumina" Version="2025.10.16.630" />
    <PackageReference Include="System.Text.Json" Version="9.0.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.66.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.Lumina.Auth">
      <HintPath>lib\Microsoft.Lumina.Auth.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Lumina.Client.Abstract">
      <HintPath>lib\Microsoft.Lumina.Client.Abstract.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Lumina.Client.Cloud">
      <HintPath>lib\Microsoft.Lumina.Client.Cloud.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Lumina.Common">
      <HintPath>lib\Microsoft.Lumina.Common.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Lumina.Utilities">
      <HintPath>lib\Microsoft.Lumina.Utilities.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>